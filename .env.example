APP_NAME="Plant CMMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plant_cmms
DB_USERNAME=root
DB_PASSWORD=

# Used only for final/live direct PostgreSQL -> MySQL cutover.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=cmms_temp
LEGACY_DB_USERNAME=cmms
LEGACY_DB_PASSWORD=

JWT_SECRET=
JWT_TTL=720

FILESYSTEM_DISK=public
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Comma-separated only if frontend/API are hosted on different origins.
ALLOWED_ORIGINS=
